# --- Trentino REI environment -------------------------------------------
# Copy to .env and adjust. Never commit real credentials.

# Storage (Redis is queue/cache ONLY, never the primary datastore)
TREI_POSTGRES_DSN=postgresql+psycopg://trei:trei@localhost:5432/trei
TREI_REDIS_URL=redis://localhost:6379/0
TREI_S3_ENDPOINT=http://localhost:9000
TREI_S3_BUCKET_RAW=trei-raw
TREI_S3_ACCESS_KEY=minioadmin
TREI_S3_SECRET_KEY=minioadmin

# Ingestion policy
# A descriptive UA with a contact is mandatory.
TREI_USER_AGENT=TREI-bot/0.1 (+https://example.org/trentino-rei; contact: data@example.org)
TREI_RESPECT_ROBOTS=true
TREI_MIN_DELAY=2.0
TREI_REQUEST_TIMEOUT=20
# Live fetching is OFF by default; enable only for legally verified sources.
TREI_ALLOW_LIVE_FETCH=false

# Versioning / provenance
TREI_SCHEMA_VERSION=1.0.0
TREI_PARSER_VERSION=0.1.0
TREI_NORMALIZATION_VERSION=0.1.0
TREI_MODEL_VERSION=0.8.0
TREI_DATA_CUTOFF=2026-09-30

# Source registry location (defaults to config/source_registry.yaml)
# TREI_REGISTRY_PATH=/app/config/source_registry.yaml

# --- Licensed / authorized feeds (tier 1-2) -------------------------------
# A source may be fetched automatically ONLY when config/source_licences.yaml
# holds an active licence record for it. See docs/authorized_feeds.md.
TREI_LICENCE_REGISTRY=config/source_licences.yaml
# Append-only evidence log (JSONL) of every access attempt - allowed or refused.
TREI_AUDIT_LOG=var/audit/access.jsonl
# robots.txt applies to licensed endpoints too unless BOTH this is false AND the
# licence record sets robots_applies: false. The double opt-in is deliberate.
TREI_FEED_RESPECT_ROBOTS=true
# Credentials for a licensed feed, per source (TREI_<SOURCE>_*). Never commit
# real values; inject them through the platform secret manager.
# TREI_IMMOBILIARE_IT_API_KEY=
# TREI_IMMOBILIARE_IT_API_KEY_HEADER=X-API-Key
# TREI_IMMOBILIARE_IT_BEARER_TOKEN=
# TREI_IMMOBILIARE_IT_USERNAME=
# TREI_IMMOBILIARE_IT_PASSWORD=
# TREI_IMMOBILIARE_IT_CLIENT_ID=
# TREI_IMMOBILIARE_IT_CLIENT_SECRET=
# TREI_IMMOBILIARE_IT_TOKEN_URL=
# TREI_IMMOBILIARE_IT_SCOPE=

# --- Phase 2 channels ------------------------------------------------------
# Data lake root for raw objects (§45):
#   raw/<source>/<date>/<crawl>/{response,html,json,screenshot}
TREI_DATALAKE_ROOT=data/raw

# Channel C - email alerts. Set IMAP_* to read a real mailbox (OAuth2 preferred);
# leave unset to ingest .eml files dropped in TREI_EMAIL_DROP_DIR. TREI never
# stores a mailbox password.
TREI_EMAIL_DROP_DIR=data/email/inbox
# TREI_IMAP_HOST=imap.example.org
# TREI_IMAP_PORT=993
# TREI_IMAP_USER=alerts@example.org
# TREI_IMAP_FOLDER=INBOX
# TREI_IMAP_OAUTH_TOKEN=

# Channel D - agent import
TREI_REVIEW_CONFIDENCE=0.75
TREI_CRAWL_MAX_REQUESTS=500
#: Wall-clock ceiling per crawl job (seconds); the run ledger records the
#: deferred tail so the next run resumes from it.
TREI_CRAWL_MAX_SECONDS=1800
TREI_CRAWL_INCREMENTAL_MIN=180
TREI_CRAWL_FULL_HOURS=168
# Rendering/vision fallbacks are OFF unless BOTH the operator opens them here
# AND the source's access mode permits them. They are extraction tools used to
# read a page, never access tools used to get past a control.
TREI_ALLOW_BROWSER=false
TREI_ALLOW_VISION=false

# Geocoding provider - deliberately unset until one is legally confirmed (§19).
# TREI_GEOCODING_PROVIDER=

# --- Kernel browser provider (§browser) ---------------------------------------
# The single credential Kernel needs. Set it locally in .env; never commit a real
# value here. When empty, every Kernel command fails with configuration_missing
# BEFORE opening any session, and offline tests / non-Kernel connectors still run.
KERNEL_API_KEY=

# Provider for jobs that need a browser. Only "kernel" is implemented.
TREI_BROWSER_PROVIDER=kernel
# "pilot" = bounded, explicitly-launched runs. Live acquisition stays off otherwise.
TREI_ACQUISITION_MODE=pilot
# Requested analysis window (a target, never a coverage guarantee).
TREI_TARGET_START_YEAR=2015
TREI_TARGET_END_YEAR=2026

# Run-wide limits (NOT per worker): a run truncated by the budget must be partial.
TREI_KERNEL_MAX_CONCURRENCY=1
TREI_KERNEL_MAX_SESSIONS_PER_RUN=5
TREI_KERNEL_MAX_SESSION_WALL_SECONDS=180
TREI_KERNEL_MAX_TOTAL_BROWSER_SECONDS=900
# Standby timeout passed to Kernel; distinct from the job wall-clock deadline.
TREI_KERNEL_STANDBY_TIMEOUT_SECONDS=60
#: ISTAT SDMX: interval between queries (official limit is 5/minute per IP)
TREI_ISTAT_MIN_INTERVAL_SECONDS=15
#: Per-portal cap on detail pages in one Kernel portal run (authorized portals)
TREI_PORTAL_MAX_LISTINGS=12

TREI_BROWSER_NAVIGATION_TIMEOUT_MS=30000
TREI_BROWSER_ACTION_TIMEOUT_MS=15000
TREI_BROWSER_MAX_PAGES_PER_SOURCE=5
TREI_BROWSER_MAX_RECORDS_PER_SOURCE=100
TREI_BROWSER_MIN_NAVIGATION_INTERVAL_SECONDS=3
TREI_BROWSER_MAX_RETRIES=2
TREI_BROWSER_RETRY_BACKOFF_SECONDS=5
TREI_BROWSER_MAX_DOWNLOAD_MB=25
# Hosts the pilot may visit (technical allow, NOT an authorisation to collect).
# Default is the ISPAT annuario host; add a redirect/download host only after
# observing and verifying it.
TREI_BROWSER_ALLOWED_DOMAINS=statweb.provincia.tn.it
